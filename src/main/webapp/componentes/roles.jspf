<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!-- roles.jspf v1.1 — Centraliza sesión y banderas de rol. Fecha: 2025-12-14. Autor: EdgarACA -->

<!-- Bloqueo si no hay sesión activa -->
<c:choose>
  <c:when test="${empty sessionScope.usuarioActivo || empty sessionScope.rol}">
    <c:redirect url="/login.jsp"/>
  </c:when>
  <c:otherwise>
    <!-- Variables de identidad disponibles en request -->
    <c:set var="usuarioActivo" value="${sessionScope.usuarioActivo}" scope="request"/>
    <c:set var="nombreActivo"  value="${sessionScope.nombreActivo}" scope="request"/>
    <c:set var="rol"           value="${sessionScope.rol}" scope="request"/>

    <!-- Banderas básicas -->
    <c:set var="isAdmin"       value="${rol == 'admin'}"       scope="request"/>
    <c:set var="isProfesor"    value="${rol == 'profesor'}"    scope="request"/>
    <c:set var="isEstudiante"  value="${rol == 'estudiante'}"  scope="request"/>
    <c:set var="isCoordinador" value="${rol == 'coordinador'}" scope="request"/>
    <c:set var="isDirector"    value="${rol == 'director'}"    scope="request"/>
    <c:set var="isAuxAdmin"    value="${rol == 'auxadmin'}"   scope="request"/>
    <c:set var="isAuxCont"     value="${rol == 'auxcont'}"    scope="request"/>

    <!-- Banderas compuestas para módulos (mantenibilidad) -->
    <c:set var="canGestionEstudiantes"
           value="${isAdmin or isDirector or isCoordinador or isAuxAdmin or isProfesor or isEstudiante}"
           scope="request"/>

    <c:set var="canGestionProfesores"
           value="${isAdmin or isDirector or isCoordinador or isProfesor}"
           scope="request"/>

    <c:set var="canCursosLibres"
           value="${isAdmin or isCoordinador}"
           scope="request"/>

    <c:set var="canClasesHorarios"
           value="${isProfesor or isCoordinador or isDirector}"
           scope="request"/>

    <c:set var="canHorarios"
           value="${isEstudiante or isProfesor or isAdmin}"
           scope="request"/>

    <c:set var="canCoordinador"
           value="${isCoordinador or isAdmin}"
           scope="request"/>

    <c:set var="canDirector"
           value="${isDirector or isAdmin}"
           scope="request"/>

    <c:set var="canContenidos"
           value="${isProfesor or isEstudiante or isAdmin}"
           scope="request"/>

    <c:set var="canNotas"
           value="${isProfesor or isEstudiante or isCoordinador or isDirector or isAdmin}"
           scope="request"/>
  </c:otherwise>
</c:choose>